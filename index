<script>
// ---- Opening ----
function startInvitation(){
  document.getElementById('opening').classList.add('hide');
  const app = document.getElementById('app');
  setTimeout(()=>app.classList.add('show'), 300);

  // La música comienza al tocar "Abrir invitación".
  // Esto evita el bloqueo de reproducción automática de los navegadores.
  const audio = document.getElementById('bgMusic');
  audio.volume = 0.45;
  audio.play().then(()=>{
    musicPlaying = true;
    document.getElementById('musicToggle').textContent = '⏸ Pausar música';
  }).catch(()=>{});
}
document.getElementById('enterButton').addEventListener('click', startInvitation);
document.getElementById('enterButton').addEventListener('touchend', function(e){e.preventDefault(); startInvitation();});

// ---- Fill CONFIG data ----
document.getElementById('parentsNames').innerHTML = '<span style="color:var(--pink-deep);">'+CONFIG.mamaNombre+'</span> & <span style="color:var(--blue-deep);">'+CONFIG.papaNombre+'</span>';
document.getElementById('closingNames').textContent = CONFIG.nombres;
document.getElementById('evFecha').textContent = CONFIG.fechaTexto;
document.getElementById('evHora').textContent = CONFIG.hora;
document.getElementById('evDir').textContent = CONFIG.direccion + ', ' + CONFIG.ciudad;
document.getElementById('mapLink').href = CONFIG.mapsUrl;
document.getElementById('bgMusic').src = CONFIG.musica;

// ---- Guest name from ?invitado= ----
try{
  const params = new URLSearchParams(window.location.search);
  const invitado = params.get('invitado');
  if(invitado){ document.getElementById('guestGreeting').textContent = 'Hola, ' + invitado; }
}catch(e){}

// ---- Countdown ----
function updateCountdown(){
  const diff = new Date(CONFIG.fechaEvento).getTime() - Date.now();
  if(diff <= 0){
    document.querySelector('.timer').style.display='none';
    document.getElementById('cdDone').style.display='block';
    return;
  }
  const d = Math.floor(diff/86400000), h = Math.floor(diff%86400000/3600000);
  const m = Math.floor(diff%3600000/60000), s = Math.floor(diff%60000/1000);
  document.getElementById('cd-d').textContent = String(d).padStart(2,'0');
  document.getElementById('cd-h').textContent = String(h).padStart(2,'0');
  document.getElementById('cd-m').textContent = String(m).padStart(2,'0');
  document.getElementById('cd-s').textContent = String(s).padStart(2,'0');
}
updateCountdown(); setInterval(updateCountdown,1000);

// ---- Team vote ----
function chooseTeam(team){
  try{ localStorage.setItem('novaInvite_team', team); }catch(e){}
  const el = document.getElementById('teamResult');
  el.textContent = 'Tu intuición dice... ' + team + '. Tu predicción quedó guardada.';
  el.classList.add('show');
}

// ---- Quiz ----
let quizIndex = 0;
function renderQuiz(){
  const card = document.getElementById('quizCard');
  if(quizIndex >= CONFIG.quiz.length){
    card.style.display='none';
    document.getElementById('quizDone').classList.add('show');
    return;
  }
  const q = CONFIG.quiz[quizIndex];
  card.innerHTML = '<div class="quiz-q active"><p>'+(quizIndex+1)+'. '+q.q+'</p>' +
    q.opts.map(o=>'<button class="quiz-opt" onclick="nextQuiz()">'+o+'</button>').join('') + '</div>';
}
function nextQuiz(){ quizIndex++; renderQuiz(); }
renderQuiz();

// ---- Gallery ----
const galleryGrid = document.getElementById('galleryGrid');
CONFIG.fotos.forEach((f,i)=>{
  const img = document.createElement('img');
  img.src = f; img.alt = 'Foto '+(i+1); img.className = 'g'+(i+1);
  img.loading = i===0 ? 'eager' : 'lazy';
  img.onclick = ()=>openLightbox(f);
  galleryGrid.appendChild(img);
});
function openLightbox(src){
  document.getElementById('lightboxImg').src = src;
  document.getElementById('lightbox').classList.add('show');
}
function closeLightbox(){ document.getElementById('lightbox').classList.remove('show'); }

// ---- RSVP ----
function confirmRSVP(going){
  const name = document.getElementById('guestName').value.trim();
  const count = Math.max(1, parseInt(document.getElementById('guestCount').value) || 1);
  if(!name){ alert('Por favor ingresá tu nombre completo.'); return; }
  try{
    const list = JSON.parse(localStorage.getItem('novaInvite_rsvp')||'[]');
    list.push({name, going, count, date:new Date().toISOString()});
    localStorage.setItem('novaInvite_rsvp', JSON.stringify(list));
  }catch(e){}
  sendToPanel(name, going, going ? count : 0);
  const status = document.getElementById('rsvpStatus');
  status.textContent = going
    ? 'Gracias '+name+'! Confirmaste tu asistencia con '+count+' persona(s).'
    : 'Gracias por avisarnos, '+name+'.';
  status.classList.add('show');
  const msg = going
    ? 'Hola! Soy '+name+'. Confirmo mi asistencia a la revelación de sexo con '+count+' persona(s). ¡No puedo esperar para descubrir el secreto! 💕'
    : 'Hola! Soy '+name+'. Lamentablemente no podré asistir a la revelación, pero estaré con ustedes en el corazón. 💕';
  window.open('https://wa.me/'+CONFIG.whatsapp+'?text='+encodeURIComponent(msg), '_blank');
}

// Envía la confirmación al panel de la organizadora (Google Form -> Google Sheets).
// No hace nada si todavía no configuraste CONFIG.googleForm (ver instrucciones al final del archivo).
function sendToPanel(name, going, count){
  try{
    if(!CONFIG.googleForm || CONFIG.googleForm.action.includes('TU_FORM_ID')) return;
    const data = new FormData();
    data.append(CONFIG.googleForm.entryNombre, name);
    data.append(CONFIG.googleForm.entryAsiste, going ? 'Sí' : 'No');
    data.append(CONFIG.googleForm.entryCantidad, String(count));
    fetch(CONFIG.googleForm.action, {method:'POST', mode:'no-cors', body:data}).catch(()=>{});
  }catch(e){}
}

// ---- Music ----
let musicPlaying = false;
function toggleMusic(){
  const audio = document.getElementById('bgMusic');
  const btn = document.getElementById('musicToggle');
  if(!musicPlaying){ audio.play().catch(()=>{}); btn.textContent = '⏸ Pausar música'; }
  else{ audio.pause(); btn.textContent = '🎵 Activar música'; }
  musicPlaying = !musicPlaying;
}
</script>
