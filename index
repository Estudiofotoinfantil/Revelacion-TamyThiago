<title>¿Nena o Nene? — El secreto más hermoso</title>
<meta name="description" content="Una invitación para descubrir juntos el secreto mejor guardado.">
<meta property="og:title" content="¿Nena o Nene?">
<meta property="og:description" content="El secreto más hermoso está a punto de revelarse.">
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>✨</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,500&family=Dancing+Script:wght@600&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --pink:#f3c9d4; --pink-deep:#e2a3b6; --blue:#bfe0ee; --blue-deep:#9dcbe0;
  --ivory:#fbf6f0; --champagne:#f0e3d3; --gold:#c9a96a; --ink:#3a3230;
  color-scheme: light;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
*{box-sizing:border-box; margin:0; padding:0;}
html{scroll-behavior:smooth; scroll-padding-top:env(safe-area-inset-top,0px);}
body{
  background:linear-gradient(180deg,var(--ivory),var(--champagne) 60%,var(--ivory));
  color:var(--ink); font-family:'DM Sans',sans-serif; overflow-x:hidden; width:100%;
}
h1,h2,.script{font-family:'Cormorant Garamond',serif; font-weight:600;}
.script{font-family:'Dancing Script',cursive; font-weight:600;}
img{max-width:100%; display:block;}
.wrap{max-width:640px; margin:0 auto; padding:0 22px;}
section{padding:90px 0; position:relative; overflow:hidden;}
.eyebrow{font-family:'DM Sans'; letter-spacing:.28em; text-transform:uppercase; font-size:.72rem; color:var(--gold);}
.center{text-align:center;}
button{font-family:inherit; cursor:pointer; border:none;}
@media (prefers-reduced-motion: reduce){*{animation-duration:.01ms !important; transition-duration:.01ms !important;}}

/* ---- Opening screen ---- */
#opening{
  position:fixed; inset:0; z-index:50; display:flex; align-items:center; justify-content:center;
  background:radial-gradient(circle at 30% 20%, var(--pink) 0%, transparent 55%),
             radial-gradient(circle at 75% 75%, var(--blue) 0%, transparent 55%),
             var(--ivory);
  transition:opacity 1s ease, visibility 1s ease;
  padding:24px;
}
#opening.hide{opacity:0; visibility:hidden; pointer-events:none;}
.opening-inner{text-align:center; max-width:420px;}
.particle{position:absolute; border-radius:50%; filter:blur(1px); opacity:.55; animation:float 7s ease-in-out infinite;}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-22px)}}
.opening-title{font-size:clamp(2.4rem,9vw,3.4rem); letter-spacing:.02em;}
.opening-sub{margin-top:14px; font-size:1.05rem; color:#6b5f5b;}
#enterButton{
  margin-top:36px; background:linear-gradient(120deg,var(--pink-deep),var(--blue-deep));
  color:#fff; padding:16px 42px; border-radius:40px; font-size:1rem; letter-spacing:.08em;
  text-transform:uppercase; box-shadow:0 10px 30px rgba(200,160,170,.4); transition:transform .25s ease;
}
#enterButton:active{transform:scale(.96);}
.tap-hint{margin-top:14px; font-size:.78rem; color:#a3968f; letter-spacing:.08em; text-transform:uppercase;}

/* ---- App ---- */
#app{opacity:0; transition:opacity 1.2s ease;}
#app.show{opacity:1;}

/* Hero */
#hero{padding:0; height:100dvh; min-height:560px; display:flex; align-items:flex-end;}
.hero-bg{position:absolute; inset:0; background:var(--heroImage) center/cover no-repeat, linear-gradient(160deg,var(--pink),var(--blue));}
.hero-overlay{position:absolute; inset:0; background:linear-gradient(0deg,rgba(58,50,48,.55),rgba(58,50,48,.05) 55%);}
.hero-content{position:relative; z-index:2; color:#fff; padding:0 26px 64px; width:100%;}
.hero-content .eyebrow{color:#f7e6cf;}
.hero-content h1{font-size:clamp(2rem,8vw,3rem); margin-top:10px; line-height:1.1;}
.hero-content p{margin-top:14px; font-size:1rem; opacity:.92; max-width:340px;}

/* Section common headers */
.head{margin-bottom:34px;}
.head h2{font-size:clamp(1.7rem,6vw,2.3rem); margin-top:8px;}

/* Parents */
#parents .card{background:rgba(255,255,255,.5); backdrop-filter:blur(6px); border:1px solid rgba(255,255,255,.6); border-radius:22px; padding:34px 26px; text-align:center;}
#parents .script{font-size:1.8rem; color:var(--pink-deep);}

/* Countdown */
#countdown{background:linear-gradient(135deg,var(--pink) 0%,var(--ivory) 45%,var(--blue) 100%);}
.timer{display:flex; gap:12px; justify-content:center; margin-top:28px; flex-wrap:wrap;}
.timer div{background:rgba(255,255,255,.65); border:1px solid rgba(255,255,255,.8); border-radius:16px; padding:16px 14px; min-width:70px; text-align:center;}
.timer span{display:block; font-family:'Cormorant Garamond'; font-size:1.9rem; font-weight:600;}
.timer small{font-size:.62rem; letter-spacing:.14em; text-transform:uppercase; color:#8a7c76;}

/* Secret */
#secret{text-align:center;}
.seal{width:150px; height:150px; margin:30px auto 0; border-radius:50%; border:2px dashed var(--gold); display:flex; align-items:center; justify-content:center; background:radial-gradient(circle,var(--pink) 0%, var(--blue) 100%); box-shadow:0 20px 40px rgba(200,180,190,.35);}
.seal span{font-family:'Cormorant Garamond'; font-size:1rem; letter-spacing:.18em; text-transform:uppercase; color:#fff; text-align:center;}

/* Intuition */
.team-grid{display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:28px;}
.team-btn{padding:34px 12px; border-radius:20px; font-family:'Cormorant Garamond'; font-size:1.3rem; text-align:center; transition:transform .2s ease, box-shadow .2s ease;}
.team-btn.nena{background:linear-gradient(160deg,var(--pink),#fff); color:#c2547a;}
.team-btn.nene{background:linear-gradient(160deg,var(--blue),#fff); color:#3f7fa3;}
.team-btn:active{transform:scale(.97);}
.team-result{margin-top:20px; text-align:center; font-size:.95rem; color:#7a6d68; display:none;}
.team-result.show{display:block;}

/* Quiz */
.quiz-card{background:#fff; border-radius:20px; padding:26px; box-shadow:0 12px 30px rgba(0,0,0,.05); margin-top:24px;}
.quiz-q{display:none;}
.quiz-q.active{display:block;}
.quiz-q p{font-size:1.05rem; margin-bottom:16px;}
.quiz-opt{display:block; width:100%; text-align:left; border-radius:12px; padding:13px 16px; margin-bottom:10px; font-size:.92rem; color:var(--ink);}
.quiz-opt:nth-child(odd){background:var(--pink); color:#8a3f5c;}
.quiz-opt:nth-child(even){background:var(--blue); color:#2f6d8f;}
.quiz-opt:active{opacity:.75;}
#quizDone{display:none; text-align:center; font-family:'Cormorant Garamond'; font-size:1.3rem; color:var(--gold);}
#quizDone.show{display:block;}

/* Gallery */
.gallery{display:grid; grid-template-columns:repeat(6,1fr); gap:8px; margin-top:28px;}
.gallery img{width:100%; height:100%; object-fit:cover; border-radius:10px; cursor:pointer;}
.g1{grid-column:span 4; grid-row:span 2; aspect-ratio:4/5;}
.g2{grid-column:span 2; aspect-ratio:1/1;}
.g3{grid-column:span 2; aspect-ratio:1/1;}
.g4{grid-column:span 3; aspect-ratio:4/5;}
.g5{grid-column:span 3; aspect-ratio:4/5;}
.g6{grid-column:span 6; aspect-ratio:16/9;}
#lightbox{position:fixed; inset:0; background:rgba(30,24,22,.92); display:none; align-items:center; justify-content:center; z-index:80; padding:20px;}
#lightbox.show{display:flex;}
#lightbox img{max-height:82vh; border-radius:10px;}
#lightbox .close{position:absolute; top:22px; right:22px; color:#fff; font-size:1.8rem; background:none;}

/* Event */
#event{background:var(--ink); color:#f4ece6;}
#event .eyebrow{color:var(--gold);}
.info-line{display:flex; gap:10px; margin-top:16px; font-size:.98rem;}
.info-line b{min-width:70px; color:var(--pink);}
.mapbtn, .rsvpbtn, .waBtn, .musicbtn{display:inline-block; margin-top:24px; background:linear-gradient(120deg,var(--pink-deep),var(--blue-deep)); color:#fff; padding:14px 28px; border-radius:40px; font-size:.88rem; letter-spacing:.06em; text-transform:uppercase;}

/* RSVP */
#rsvp input{width:100%; padding:14px 16px; border-radius:12px; border:1px solid #ddd0c6; margin-top:16px; font-size:1rem; font-family:inherit;}
#rsvp label{display:block; margin-top:16px; font-size:.8rem; color:#a3968f; text-transform:uppercase; letter-spacing:.06em; text-align:left;}
.rsvp-choices{display:flex; gap:12px; margin-top:16px;}
.rsvp-choices button{flex:1; padding:14px; border-radius:12px; font-size:.95rem;}
#rsvpYes{background:var(--pink); }
#rsvpNo{background:var(--champagne);}
#rsvpStatus{margin-top:16px; font-size:.9rem; color:#7a6d68; display:none;}
#rsvpStatus.show{display:block;}

/* Smoke */
#smoke{height:60vh; min-height:380px; background:var(--ink); position:relative; display:flex; align-items:center; justify-content:center; text-align:center; color:#fff;}
.puff{position:absolute; border-radius:50%; filter:blur(30px); opacity:.5; animation:drift 9s ease-in-out infinite;}
.puff.p1{width:220px; height:220px; background:var(--pink); left:20%; top:30%;}
.puff.p2{width:260px; height:260px; background:var(--blue); right:15%; top:40%; animation-delay:-3s;}
.puff.p3{width:180px; height:180px; background:var(--pink); left:45%; top:55%; animation-delay:-6s;}
@keyframes drift{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(20px,-30px) scale(1.15)}}
#smoke .content{position:relative; z-index:2;}

/* Closing */
#closing{text-align:center; padding-bottom:140px;}
#closing .script{font-size:2.2rem; color:var(--pink-deep); margin-top:6px;}

/* Music toggle floating */
#musicToggle{position:fixed; bottom:calc(20px + env(safe-area-inset-bottom,0px)); right:20px; z-index:40; background:#fff; border-radius:50px; padding:10px 18px; font-size:.8rem; box-shadow:0 8px 20px rgba(0,0,0,.12);}
</style>
</head>
<body>

